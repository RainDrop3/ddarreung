#!/bin/sh
# push 에 코드 변경이 있으면 worklog/ 문서도 같은 push 에 들어 있어야 한다.
# 설치는 worklog 플러그인의 SessionStart 훅이 대신 한다 (git config core.hooksPath .githooks).

# push 를 막을 때 보여 줄 안내의 언어: en | ko
lang=ko

fail=0

while read -r local_ref local_sha remote_ref remote_sha; do
	case "$local_sha" in *[!0]*) ;; *) continue ;; esac          # 브랜치 삭제
	case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac    # 태그 등

	# 이번 push 분량 = 원격 어디에도 아직 없는 커밋. 그 커밋들이 바꾼 파일을 모은다.
	changed=$(git log --format= --name-only "$local_sha" --not --remotes | sed '/^$/d' | sort -u)
	[ -n "$changed" ] || continue

	code=$(printf '%s\n' "$changed" | grep -cv '^worklog/')
	[ "$code" -gt 0 ] || continue
	printf '%s\n' "$changed" | grep -q '^worklog/[^/][^/]*/' && continue   # README 는 문서로 치지 않는다

	if [ "$lang" = ko ]; then
		echo "  $local_ref — 코드 변경 ${code}개, worklog 문서 0개" >&2
	else
		echo "  $local_ref — ${code} code change(s), 0 worklog documents" >&2
	fi
	fail=1
done

[ "$fail" = 0 ] && exit 0

if [ "$lang" = ko ]; then
	cat >&2 <<'EOF'

  push 를 막았습니다 — worklog 문서가 없습니다.

  Claude Code 에서 /worklog:write 를 실행하면 이번 push 분량을 읽어
  worklog/ 에 문서를 만들고 커밋합니다. 그 뒤 다시 push 하세요.

EOF
else
	cat >&2 <<'EOF'

  Push blocked — no worklog document.

  Run /worklog:write in Claude Code. It reads this push, writes a document
  under worklog/ and commits it. Then push again.

EOF
fi
exit 1
