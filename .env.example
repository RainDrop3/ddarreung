# --- 열린데이터광장 Open API ---
SEOUL_OPEN_API_KEY=

# --- 데이터 레이크 (S3 호환: R2 / AWS S3 / 로컬 S3 모두 endpoint만 바꿔서 사용) ---
S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=ddareungi-lake
S3_REGION=auto

# --- Airflow / Postgres (로컬 Compose용) ---
# 로컬 전용 값이라 아무 값이나 되지만 비밀번호는 URL에 들어가므로 영숫자만 쓴다.
# FERNET_KEY 생성: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# 나머지 시크릿 생성: python -c "import secrets;print(secrets.token_hex(16))"
AIRFLOW_UID=50000
FERNET_KEY=
AIRFLOW_JWT_SECRET=
AIRFLOW_DB_PASSWORD=
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=
WAREHOUSE_DB_USER=ddareungi
WAREHOUSE_DB_PASSWORD=
WAREHOUSE_DB_NAME=ddareungi
